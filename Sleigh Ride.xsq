    <Element type="timing" name="Main Vocals">
      <EffectLayer>
        <Effect label="Just hear those sleigh bells jingling ring tingle tingling too" startTime="25450" endTime="30000"></Effect>
        <Effect label="Come on, it's lovely weather for a sleigh ride together with you" startTime="30650" endTime="35200"></Effect>
        <Effect label="Outside the snow is falling and friends are calling. You hoo" startTime="35850" endTime="40450"></Effect>
        <Effect label="Come on, it's lovely weather for a sleigh ride together with you" startTime="41100" endTime="46350"></Effect>
        <Effect label="Our cheeks are nice and rosy and comfy cosy are we" startTime="59350" endTime="63900"></Effect>
        <Effect label="We're snuggled up together like two birds of a feather would be" startTime="64550" endTime="69150"></Effect>
