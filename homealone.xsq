    <Element type="timing" name="Tree Voice">
      <EffectLayer>
        <Effect label="What?" startTime="22900" endTime="23650">X_Effect_Locked=True</Effect>
        <Effect label="This house is so full of people, it makes me sick. When I grow up and get married, I'm living alone. Did you hear me? I'm living alone. I'm living alone. I'm living alone." startTime="34100" endTime="47950">X_Effect_Locked=True</Effect>
        <Effect label="I made my family disappear." startTime="85150" endTime="87700">X_Effect_Locked=True</Effect>
        <Effect label="This is it, don't get scared now." startTime="143400" endTime="145850">X_Effect_Locked=True</Effect>
