    <Element type="timing" name="Voice 2">
      <EffectLayer>
        <Effect label="Kevin, you're such a disease." startTime="15400" endTime="17300">X_Effect_Locked=True</Effect>
        <Effect label="There's no way on earth we're going to make this plane. It leaves in 45 minutes." startTime="62100" endTime="66000">X_Effect_Locked=True</Effect>
        <Effect label="Were rockin' around, the Christmas tree, at the Christmas party hop." startTime="94400" endTime="99800">X_Effect_Locked=True</Effect>
        <Effect label="Later we'll have some pumpkin pie, and do some caroling." startTime="101150" endTime="106600">X_Effect_Locked=True</Effect>
        <Effect label="Rocking around the Christmas tree, have a happy holiday. Everyone dancing merrily in the new old-fashioned way." startTime="121300" endTime="140950">X_Effect_Locked=True</Effect>
      </EffectLayer>
