    <Element type="timing" name="Main Vocals">
      <EffectLayer>
        <Effect label="I was working in the lab, late one night" startTime="15650" endTime="19100"></Effect>
        <Effect label="When my eyes beheld an eerie sight" startTime="19100" endTime="22550"></Effect>
        <Effect label="For my monster from his slab, began to rise" startTime="22800" endTime="26250"></Effect>
        <Effect label="And suddenly to my surprise" startTime="26250" endTime="29650"></Effect>
        <Effect label="He did the monster mash" startTime="30900" endTime="33000"></Effect>
        <Effect label="It was a graveyard smash" startTime="34450" endTime="36750"></Effect>
        <Effect label="It caught on in a flash" startTime="37900" endTime="39750"></Effect>
        <Effect label="He did the monster mash" startTime="41300" endTime="43200"></Effect>
        <Effect label="From my laboratory in the castle east" startTime="43200" endTime="46600"></Effect>
        <Effect label="To the master bedroom where the vampires feast" startTime="46600" endTime="50250"></Effect>
        <Effect label="The ghouls all came from their humble abodes" startTime="50250" endTime="53700"></Effect>
        <Effect label="To get a jolt from my electrodes" startTime="53700" endTime="56900"></Effect>
        <Effect label="They did the monster mash" startTime="58350" endTime="60500"></Effect>
        <Effect label="It was a graveyard smash" startTime="61850" endTime="64200"></Effect>
        <Effect label="It caught on in a flash" startTime="65250" endTime="67150"></Effect>
        <Effect label="They did the monster mash" startTime="68700" endTime="70600"></Effect>
        <Effect label="The zombies were having fun" startTime="71050" endTime="73850"></Effect>
        <Effect label="the party had just begun" startTime="74300" endTime="77100"></Effect>
        <Effect label="The guests included Wolfman" startTime="77700" endTime="80900"></Effect>
        <Effect label="Dracula, and his son" startTime="81150" endTime="83850"></Effect>
        <Effect label="The scene was rockin', all were digging the sounds" startTime="84500" endTime="88200"></Effect>
        <Effect label="Igor on chains, backed by his baying hounds" startTime="88200" endTime="91150"></Effect>
        <Effect label="The coffin bangers were about to arrive" startTime="91350" endTime="94600"></Effect>
        <Effect label="With their vocal group, The Crypt Kicker Five" startTime="94600" endTime="98250"></Effect>
        <Effect label="They played the monster mash" startTime="99500" endTime="101700"></Effect>
        <Effect label="It was a graveyard smash" startTime="103000" endTime="105550"></Effect>
        <Effect label="It caught on in a flash" startTime="106450" endTime="108600"></Effect>
        <Effect label="They played the monster mash" startTime="109850" endTime="112250"></Effect>
        <Effect label="Out from his coffin' Drac's voice did ring" startTime="112250" endTime="115450"></Effect>
        <Effect label="Seems he was troubled by just one thing" startTime="115450" endTime="118850"></Effect>
        <Effect label="He opened the lid and shook his fist and said" startTime="118850" endTime="123000"></Effect>
        <Effect label="What ever happened to my Transylvania Twist?" startTime="123000" endTime="125550"></Effect>
        <Effect label="It's now the monster mash" startTime="127100" endTime="129250"></Effect>
        <Effect label="And it's a graveyard smash" startTime="130550" endTime="133100"></Effect>
        <Effect label="It caught on in a flash" startTime="134000" endTime="136150"></Effect>
        <Effect label="It's now the monster mash" startTime="137400" endTime="139350"></Effect>
        <Effect label="Now everythings cool, Drac's a part of the band" startTime="139350" endTime="142800"></Effect>
        <Effect label="And my Monster Mash is the hit of the land" startTime="142800" endTime="146500"></Effect>
        <Effect label="For you, the living this mash was meant too" startTime="146500" endTime="149700"></Effect>
        <Effect label="When you get to my door, tell them Boris sent you" startTime="149700" endTime="153600"></Effect>
        <Effect label="Then you can monster mash" startTime="154650" endTime="156950"></Effect>
        <Effect label="And do my graveyard smash" startTime="158050" endTime="160850"></Effect>
        <Effect label="You'll catch on in a flash" startTime="161500" endTime="163900"></Effect>
        <Effect label="Then you can monster mash" startTime="164950" endTime="167250"></Effect>
        <Effect label="Easy, Igor, you impetuous young boy" startTime="170650" endTime="174400"></Effect>
      </EffectLayer>
